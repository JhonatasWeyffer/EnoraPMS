// ============================================================
// Configuração do Prisma Client
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS (PADRONIZAÇÃO E TRAVA DE REGRAS DE NEGÓCIO)
// ============================================================

enum Perfil {
  ADMINISTRADOR
  GERENTE
  SUPORTE_TI
  COLABORADOR
}

enum SituacaoQuarto {
  LIVRE
  MANUTENCAO
  RESERVADO
  OCUPADO
  LIMPEZA
}

enum StatusReserva {
  CRIADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
  NOSHOW
}

// CORREÇÃO FNRH: Alinhado exatamente com o Domínio de Situações do Governo (v2)
enum StatusHospede {
  PRECHECKIN_NAOVINCULADO
  PRECHECKIN_PENDENTE
  PRECHECKIN_REALIZADO
  CHECKIN_REALIZADO
  CHECKOUT_REALIZADO
  NOSHOW
  CANCELADO
}

enum StatusManutencao {
  EM_ABERTO
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum PrioridadeManutencao {
  ALTA
  MEDIA
  BAIXA
}

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum StatusGovernanca {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

// CORREÇÃO FNRH: Novos Enums restritos exigidos pela documentação oficial
enum TipoDocumento {
  CPF
  PASSAPORTE
}

enum FnrhGenero {
  HOMEM
  MULHER
  OUTRO
  NAOINFORMADO
}

enum FnrhRaca {
  AMARELA
  BRANCA
  INDIGENA
  PARDA
  PRETA
  NAOINFORMAR
}

enum FnrhMeioTransporte {
  ONIBUS
  AUTOMOVEL
  AVIAO
  MOTO
  NAVIO_BARCO
  PE
  TREM
  BICICLETA
}

enum FnrhMotivoViagem {
  COMPRAS
  CONGRESSO_FEIRA
  ESTUDOS_CURSOS
  LAZER_FERIAS
  NEGOCIOS
  PARENTES_AMIGOS
  RELIGIAO
  SAUDE
}

// ============================================================
// MÓDULOS DE SISTEMA E SEGURANÇA
// ============================================================

model Usuario {
  id        Int    @id @default(autoincrement())
  nome      String
  email     String @unique
  cpf       String @unique // CORREÇÃO FNRH: Campo exigido para auditoria militar no header 'cpf_solicitante'
  senhaHash String
  perfil    Perfil @default(COLABORADOR)

  // Rastreabilidade de ações (Auditoria real)
  hospedesCriados     Hospede[]   @relation("UsuarioCriadorHospede")
  hospedesAtualizados Hospede[]   @relation("UsuarioAtualizadorHospede")
  reservasCriadas     Reserva[]   @relation("UsuarioCriadorReserva")
  reservasAtualizadas Reserva[]   @relation("UsuarioAtualizadorReserva")
  reservasCanceladas  Reserva[]   @relation("ReservaCancelador")
  logsAcesso          LogAcesso[]
}

model LogAcesso {
  id Int @id @default(autoincrement())

  usuarioId Int? // Opcional: tentativa falha pode usar um e-mail que não existe
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  emailTentado String
  ip           String
  userAgent    String?
  tentativa    Boolean

  criadoEm DateTime @default(now())

  @@index([emailTentado])
  @@index([criadoEm])
}

// ============================================================
// MÓDULO DE QUARTOS
// ============================================================

model Quarto {
  id     Int     @id @default(autoincrement())
  numero String  @unique
  bloco  String?
  andar  Int?
  tipo   String  @default("Não definido")

  situacoes         StatusQuarto[]
  reservas          Reserva[]
  manutencoes       Manutencao[]
  tarefasGovernanca Governanca[]
}

model StatusQuarto {
  id       Int            @id @default(autoincrement())
  quartoId Int
  quarto   Quarto         @relation(fields: [quartoId], references: [id])
  situacao SituacaoQuarto
  criadoEm DateTime       @default(now())
}

// ============================================================
// ENTIDADES PRINCIPAIS (HÓSPEDE E RESERVA)
// ============================================================

model Hospede {
  id                String     @id @default(uuid()) @db.Uuid
  fnrhPessoaId      String?    @unique @db.Uuid // CORREÇÃO FNRH: Guarda o UUID oficial do Serpro
  
  nome              String
  nomeSocial        String?
  paisNacionalidade String     @default("BR") // CORREÇÃO FNRH: Exige ISO 3166-1 alpha-2
  genero            FnrhGenero // CORREÇÃO FNRH: Tipagem forte 
  generoDescricao   String?    // Criado pq o ser humano não tem o que inventar (Obrigatório se genero = OUTRO)
  dataNascimento    DateTime   @db.Date
  raca              FnrhRaca?  // CORREÇÃO FNRH: Tipagem forte
  possuiDeficiencia String     @default("NAO")
  tipoDeficiencia   String?

  tipoDocumento   TipoDocumento @default(CPF) // CORREÇÃO FNRH: CPF ou PASSAPORTE
  numeroDocumento String        @unique

  email    String?
  telefone String?

  paisResidencia   String  @default("BR") // CORREÇÃO FNRH: Diferenciação obrigatória na v2
  cep              String?
  logradouro       String?
  numeroEndereco   String?
  complemento      String?
  bairro           String?
  codigoIbgeCidade String? // CORREÇÃO FNRH: Exigido código de 7 dígitos
  nomeCidade       String?
  estado           String?

  criadoPorId     Int?
  criador         Usuario? @relation("UsuarioCriadorHospede", fields: [criadoPorId], references: [id])
  atualizadoPorId Int?
  atualizador     Usuario? @relation("UsuarioAtualizadorHospede", fields: [atualizadoPorId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  reservasComoResponsavel Reserva[]        @relation("Responsavel")
  reservasVinculadas      ReservaHospede[]
  vinculosCorporativos    Funcionario[]

  @@index([email])
  @@index([nome])
  @@index([criadoEm])
}

model Reserva {
  id               String        @id @default(uuid()) @db.Uuid
  fnrhReservaId    String?       @unique @db.Uuid // CORREÇÃO FNRH: Guarda o UUID da Reserva do Serpro
  numeroReserva    String        @unique
  numeroReservaOta String?
  dataEntrada      DateTime      @db.Date
  dataSaida        DateTime      @db.Date
  origemReservaId  String        @default("MEIOHOSPEDAGEM")
  situacao         StatusReserva @default(CRIADA)

  quartoId Int?
  quarto   Quarto? @relation(fields: [quartoId], references: [id])

  valorTotal      Decimal?  @db.Decimal(10, 2)
  formaPagamento  String?
  statusPagamento String    @default("pendente")
  pagoEm          DateTime? @db.Date
  
  // CORREÇÃO FNRH: meioTransporte e motivoViagem removidos daqui, pois pertencem à Ficha individual (ReservaHospede)
  linkPreCheckin  String?

  quantidadeHospedeAdulto Int @default(1)
  quantidadeHospedeMenor  Int @default(0)

  hospedeResponsavelId String  @db.Uuid
  hospedeResponsavel   Hospede @relation("Responsavel", fields: [hospedeResponsavelId], references: [id])
  hospedes             ReservaHospede[]

  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  criadoPorId     Int?
  criador         Usuario? @relation("UsuarioCriadorReserva", fields: [criadoPorId], references: [id])
  atualizadoPorId Int?
  atualizador     Usuario? @relation("UsuarioAtualizadorReserva", fields: [atualizadoPorId], references: [id])

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  canceladoPorId Int?
  cancelador     Usuario?  @relation("ReservaCancelador", fields: [canceladoPorId], references: [id])
  canceladoEm    DateTime?

  transacoesFinanceiras Financeiro[]

  @@index([quartoId, situacao, dataEntrada, dataSaida])
  @@index([hospedeResponsavelId])
}

model ReservaHospede {
  id            String        @id @default(uuid()) @db.Uuid
  fnrhHospedeId String?       @unique @db.Uuid // CORREÇÃO FNRH: Guarda o UUID da relação hospede-reserva no Serpro
  
  reservaId     String        @db.Uuid
  hospedeId     String        @db.Uuid
  situacao      StatusHospede @default(PRECHECKIN_NAOVINCULADO)
  responsavel   Boolean       @default(false)

  // CORREÇÃO FNRH: Movidos para a Ficha individual do hóspede
  meioTransporte FnrhMeioTransporte?
  motivoViagem   FnrhMotivoViagem?
  
  // CORREÇÃO FNRH: Caso seja menor, deve indicar o UUID do responsável na mesma Ficha
  responsavelFichaId String? @db.Uuid 

  preCheckinEm DateTime?
  checkinEm    DateTime?
  checkoutEm   DateTime?
  noShowEm     DateTime?
  
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  hospede Hospede @relation(fields: [hospedeId], references: [id])

  @@unique([reservaId, hospedeId])
}

// ============================================================
// MÓDULO CORPORATIVO
// ============================================================

model Empresa {
  id                       Int      @id @default(autoincrement())
  razaoSocial              String
  cnpj                     String   @unique
  desconto                 Decimal  @db.Decimal(5, 2)
  valorBaseDiaria          Decimal  @default(80.00) @db.Decimal(10, 2)
  contatoFinanceiroNome    String?
  contatoFinanceiroTipoDoc String?
  contatoFinanceiroNumDoc  String?
  criadoEm                 DateTime @default(now())
  atualizadoEm             DateTime @updatedAt

  funcionarios Funcionario[]
  reservas     Reserva[]
}

model Funcionario {
  id Int @id @default(autoincrement())

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  hospedeId String  @db.Uuid
  hospede   Hospede @relation(fields: [hospedeId], references: [id], onDelete: Cascade)

  hospedadoAtualmente Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, hospedeId])
}

// ============================================================
// MÓDULO DE MANUTENÇÃO 
// ============================================================

model Manutencao {
  id Int @id @default(autoincrement())

  quartoId Int
  quarto   Quarto @relation(fields: [quartoId], references: [id])

  descricao  String
  tipo       String
  prioridade PrioridadeManutencao @default(MEDIA)
  status     StatusManutencao     @default(EM_ABERTO)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ============================================================
// MÓDULO GOVERNANÇA 
// ============================================================

model Governanca {
  id Int @id @default(autoincrement())

  quartoId Int
  quarto   Quarto @relation(fields: [quartoId], references: [id])

  tipo       String               @default("Check-out")
  descricao  String?
  status     StatusGovernanca     @default(PENDENTE)
  prioridade PrioridadeManutencao @default(MEDIA)

  dataPrevista DateTime @default(now()) @db.Date
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([dataPrevista])
}

// ============================================================
// MÓDULO CAIXA DIÁRIO 
// ============================================================

model Financeiro {
  id        Int           @id @default(autoincrement())
  descricao String
  valor     Decimal       @db.Decimal(10, 2)
  metodo    String
  tipo      TipoTransacao

  reservaId String?  @db.Uuid
  reserva   Reserva? @relation(fields: [reservaId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ============================================================
// MÓDULO DE LEMBRETES DO TURNO
// ============================================================

model LembreteTurno {
  id           Int      @id @default(autoincrement())
  titulo       String?
  descricao    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("LembreteTurno")
}